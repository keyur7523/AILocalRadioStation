# Backend (Nest) configuration — copy to .env to override defaults.

# HTTP port the broadcast server listens on.
PORT=3001

# Which log levels to emit (comma-separated). Defaults to ALL levels so Render's
# logs show everything. For just the essentials use: error,warn,log
# (drops the per-item decode / prefetch / HTTP-request detail at debug+verbose).
# LOG_LEVELS=error,warn,log,debug,verbose

# Comma-separated allowed origins for CORS. Defaults to allow-all in dev.
CORS_ORIGIN=http://localhost:3000

# Folder of .mp3 files that make up the rotation (defaults to ./media).
# MEDIA_DIR=/absolute/path/to/media

# Trim dead air from the start/end of each song so the rotation sounds tight.
# Each file is analyzed once (cached); silence in the MIDDLE of a track is kept.
TRIM_SILENCE=true
# Level (dBFS) below which audio counts as silence. Lower = stricter (trims less).
TRIM_THRESHOLD_DB=-50
# Ignore silences shorter than this (seconds) so fades aren't clipped.
TRIM_MIN_SILENCE=0.2

# Encode settings for the live stream (constant bitrate keeps listeners synced).
STREAM_BITRATE=128k
STREAM_SAMPLE_RATE=44100
STREAM_RESTART_DELAY_MS=1000

# On-air identity, shown in the player and as ICY stream metadata.
STATION_NAME=KIND FM
STATION_FREQUENCY=98.7
STATION_TAGLINE=your local sound, on a loop
STATION_CITY=Anytown
# IANA timezone the DJ announces local time in (DST-aware). Set to your zone.
# This is the SEED value; the station identity can be changed live via the admin
# API (GET/PUT /admin/config — apply a US-timezone preset like "nyc"/"cupertino"
# or set a custom name/timezone). NOTE: the admin API is currently unauthenticated
# — put it behind an auth guard before exposing the backend publicly.
STATION_TIMEZONE=America/New_York
# Where the admin-selected station identity is persisted (survives restarts;
# resets on a full redeploy unless a Render disk is mounted at this path).
# STATION_STATE_FILE=/tmp/radio-station.json

# DJ time-check interstitial (Phase II).
DJ_ENABLED=true
DJ_EVERY_N_SONGS=1
# Talk OVER the song's fading tail with ducking (true) vs back-to-back (false).
# false = the DJ speaks as its own segment, cleanly separated by DJ_GAP below.
DJ_OVERLAP=false
# Seconds of silence inserted between every item (song ↔ time-check ↔ song).
# Set 0 for seamless back-to-back. Only audible when DJ_OVERLAP=false.
DJ_GAP=0.5
# Seconds of music-only outro left after the DJ voice ends (overlap mode only).
DJ_TAIL_PAD=0.5
# Generate-ahead lead (seconds): synthesize the next DJ clip this many seconds
# before the current song ends, so it's ready at the boundary (no silence gap).
# Keep small so a spoken time-check stays accurate to the minute.
DJ_PREFETCH_LEAD=3
# Seconds added to the announced time to compensate for pipeline + player
# latency (generate-ahead + stream buffering), so the spoken time matches your
# clock when you HEAR it. Increase if the DJ still sounds behind; decrease if it
# now sounds ahead. Typical browser stream buffering is ~6-10s.
DJ_TIME_OFFSET_SEC=10
# Which TTS engine the DJ uses: espeak | piper.
# The Docker image (production) defaults to piper (natural neural voice) via an
# image ENV. For LOCAL dev, espeak is the safe default (no piper binary needed).
DJ_TTS_ENGINE=espeak
# Piper voice model path — only used when DJ_TTS_ENGINE=piper. Baked into the
# Docker image at /app/voices; override to swap voices.
# DJ_VOICE_MODEL=/app/voices/en_US-lessac-medium.onnx
# Path to the piper binary (Docker image sets this to the bundled standalone build).
# PIPER_PATH=/opt/piper/piper
# Where synthesized DJ clips are cached (defaults under the OS temp dir).
# DJ_CACHE_DIR=/tmp/radio-dj-clips
